{
  "expo": {
    "name": "Smart Billing",
    "slug": "smart-billing-scanner",
    "version": "1.0.0",
    "scheme": "smartbilling",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartbilling.scanner"
    },
    "android": {
      "package": "com.smartbilling.scanner",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Smart Billing to use the camera for barcode scanning.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smart Billing to select product photos.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser"
    ],
    "extra": {
      "supportsOfflineMode": true,
      "eas": {
        "projectId": "095ab830-9e52-4603-9af7-546d621b13d1"
      }
    },
    "owner": "yuvi1173"
  }
}
