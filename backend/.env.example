APP_DEEP_LINK=smartbilling://subscription/payment

TRIAL_DAYS=7
SUBSCRIPTION_AMOUNT_PAISE=30000
RAZORPAY_TOTAL_COUNT=120
RAZORPAY_KEY_ID=rzp_test_replace_me
